# Server
PORT=9453
NODE_ENV=development

# Database
DB_HOST=192.168.1.2
DB_PORT=5432
DB_NAME=photonb
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres_aqui

# JWT
JWT_SECRET=sua_chave_jwt_secreta_longa_aqui
JWT_EXPIRES_IN=7d

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=1024

# Thumbnails
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400

# Face Recognition (models will be downloaded automatically)
FACE_MODELS_PATH=./models
FACE_DETECTION_THRESHOLD=0.5

# CORS
CORS_ORIGIN=*